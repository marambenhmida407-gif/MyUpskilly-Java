<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<ScrollPane fitToWidth="true"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.yessine.VoirReponseController"
            style="-fx-background-color: #f4f7fb; -fx-background: #f4f7fb;">

    <VBox spacing="0" style="-fx-background-color: #f4f7fb;">

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- TOP NAV BAR — same as other pages                   -->
        <!-- ═══════════════════════════════════════════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #0a3d5c;
                     -fx-padding: 14 28 14 28;
                     -fx-effect: dropshadow(gaussian, #00000033, 8, 0, 0, 3);">

            <Label text="⚕"
                   style="-fx-font-size: 26px; -fx-text-fill: #4dd9ac;"/>
            <VBox spacing="0">
                <Label text="MedQA"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;
                              -fx-text-fill: white;"/>
                <Label text="Plateforme Médicale"
                       style="-fx-font-size: 9px; -fx-text-fill: #7ecfef;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="← Retour" onAction="#retour"
                    style="-fx-background-color: #1a6e8f; -fx-text-fill: white;
                           -fx-font-size: 11px; -fx-font-weight: bold;
                           -fx-background-radius: 20; -fx-pref-height: 32;
                           -fx-padding: 0 14 0 14;"/>

            <Button text="⏻  Déconnexion" onAction="#seDeconnecter"
                    style="-fx-background-color: #c0392b; -fx-text-fill: white;
                           -fx-font-size: 11px; -fx-font-weight: bold;
                           -fx-background-radius: 20; -fx-pref-height: 32;
                           -fx-padding: 0 14 0 14;"/>
        </HBox>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- HERO BANNER — question title                        -->
        <!-- ═══════════════════════════════════════════════════ -->
        <VBox spacing="6"
              style="-fx-background-color: #0a3d5c;
                     -fx-padding: 20 28 20 28;">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="🩺" style="-fx-font-size: 28px;"/>
                <VBox spacing="4">
                    <Label fx:id="titrePage"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;
                                  -fx-text-fill: white; -fx-wrap-text: true;"/>
                    <Label fx:id="categorieLabel"
                           style="-fx-text-fill: #4dd9ac; -fx-font-size: 12px;"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT — 3 COLUMNS                           -->
        <!-- ═══════════════════════════════════════════════════ -->
        <HBox spacing="18" style="-fx-padding: 20 28 28 28;" alignment="TOP_LEFT">

            <!-- ─────────────────────────────────────────────── -->
            <!-- LEFT COLUMN                                     -->
            <!-- ─────────────────────────────────────────────── -->
            <VBox spacing="16" prefWidth="220" minWidth="200">

                <!-- Navigation card -->
                <VBox spacing="12"
                      style="-fx-background-color: white; -fx-padding: 20;
                             -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, #00000018, 12, 0, 0, 4);
                             -fx-border-color: #d0e8f5; -fx-border-radius: 16;
                             -fx-border-width: 1.5;">
                    <Label text="💬" style="-fx-font-size: 28px;"/>
                    <Label text="Consultation médicale"
                           style="-fx-font-size: 13px; -fx-font-weight: bold;
                                  -fx-text-fill: #0a3d5c; -fx-wrap-text: true;"/>
                    <Label text="Consultez la réponse complète du médecin et donnez votre avis"
                           style="-fx-wrap-text: true; -fx-text-fill: #666;
                                  -fx-font-size: 11px;"/>
                    <Button text="← Retour aux questions" onAction="#retour"
                            style="-fx-background-color: #0a3d5c; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-pref-width: 185;
                                   -fx-pref-height: 36; -fx-background-radius: 10;
                                   -fx-font-size: 11px;"/>
                </VBox>

                <!-- Actes relatifs -->
                <VBox spacing="10"
                      style="-fx-background-color: white; -fx-padding: 18;
                             -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, #00000018, 12, 0, 0, 4);
                             -fx-border-color: #d0e8f5; -fx-border-radius: 16;
                             -fx-border-width: 1.5;">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="📋" style="-fx-font-size: 16px;"/>
                        <Label text="Actes relatifs"
                               style="-fx-font-size: 13px; -fx-font-weight: bold;
                                      -fx-text-fill: #0a3d5c;"/>
                    </HBox>
                    <VBox spacing="7" style="-fx-padding: 4 0 0 0;">
                        <Label text="  Chirurgie de la cataracte"
                               style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
                        <Label text="  Correction de la vision..."
                               style="-fx-font-size: 11px; -fx-text-fill: #555;
                                      -fx-wrap-text: true;"/>
                        <Label text="  Injection péri-oculaire..."
                               style="-fx-font-size: 11px; -fx-text-fill: #555;
                                      -fx-wrap-text: true;"/>
                        <Label text="  Angiographie en fluorescence"
                               style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
                    </VBox>
                </VBox>

                <!-- Info pills -->
                <VBox spacing="10"
                      style="-fx-background-color: #0a3d5c; -fx-padding: 18;
                             -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, #00000018, 12, 0, 0, 4);">
                    <Label text="ℹ️ À savoir"
                           style="-fx-font-size: 13px; -fx-font-weight: bold;
                                  -fx-text-fill: #4dd9ac;"/>
                    <Label text="🔒  Consultation confidentielle"
                           style="-fx-font-size: 11px; -fx-text-fill: #7ecfef;
                                  -fx-wrap-text: true;"/>
                    <Label text="👨‍⚕️  Réponse de médecin certifié"
                           style="-fx-font-size: 11px; -fx-text-fill: #7ecfef;
                                  -fx-wrap-text: true;"/>
                    <Label text="⚡  Avis non substitutif à une consultation"
                           style="-fx-font-size: 11px; -fx-text-fill: #7ecfef;
                                  -fx-wrap-text: true;"/>
                </VBox>

            </VBox>

            <!-- ─────────────────────────────────────────────── -->
            <!-- MIDDLE COLUMN — main content                    -->
            <!-- ─────────────────────────────────────────────── -->
            <VBox spacing="16" HBox.hgrow="ALWAYS">

                <!-- Question description card -->
                <VBox spacing="0"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, #00000018, 12, 0, 0, 4);
                             -fx-border-color: #d0e8f5; -fx-border-radius: 16;
                             -fx-border-width: 1.5;">

                    <!-- Card header -->
                    <HBox spacing="10" alignment="CENTER_LEFT"
                          style="-fx-background-color: #f0f7ff;
                                 -fx-padding: 14 20 14 20;
                                 -fx-background-radius: 16 16 0 0;
                                 -fx-border-color: #e0eef8;
                                 -fx-border-width: 0 0 1 0;">
                        <Label text="📝" style="-fx-font-size: 16px;"/>
                        <Label text="Description de la question"
                               style="-fx-font-size: 14px; -fx-font-weight: bold;
                                      -fx-text-fill: #0a3d5c;"/>
                    </HBox>

                    <VBox spacing="12" style="-fx-padding: 20;">
                        <Label fx:id="questionDescLabel"
                               style="-fx-wrap-text: true; -fx-font-size: 13px;
                                      -fx-text-fill: #333; -fx-line-spacing: 4;"/>
                        <!-- Image uploaded by patient -->
                        <VBox fx:id="imageContainer" spacing="10"/>
                    </VBox>
                </VBox>

                <!-- Doctor answer card -->
                <VBox spacing="0"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, #00000018, 12, 0, 0, 4);
                             -fx-border-color: #4dd9ac; -fx-border-radius: 16;
                             -fx-border-width: 2;">

                    <!-- Card header -->
                    <HBox spacing="10" alignment="CENTER_LEFT"
                          style="-fx-background-color: #f0faf6;
                                 -fx-padding: 14 20 14 20;
                                 -fx-background-radius: 16 16 0 0;
                                 -fx-border-color: #c8eee0;
                                 -fx-border-width: 0 0 1 0;">
                        <Label text="👨‍⚕️" style="-fx-font-size: 20px;"/>
                        <VBox spacing="2">
                            <Label fx:id="doctorNameLabel"
                                   style="-fx-font-weight: bold; -fx-text-fill: #0a3d5c;
                                          -fx-font-size: 15px;"/>
                            <Label fx:id="doctorSpecLabel"
                                   style="-fx-text-fill: #4dd9ac; -fx-font-size: 12px;"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="16" style="-fx-padding: 20;">

                        <!-- Answer text -->
                        <Label fx:id="reponseLabel"
                               style="-fx-wrap-text: true; -fx-font-size: 13px;
                                      -fx-text-fill: #333; -fx-line-spacing: 5;"/>

                        <Separator/>

                        <!-- Feedback section — hidden for doctors in controller -->
                        <VBox fx:id="feedbackSection" spacing="14"
                              style="-fx-background-color: #f4f7fb; -fx-padding: 18;
                                     -fx-background-radius: 12;
                                     -fx-border-color: #d0e8f5; -fx-border-radius: 12;
                                     -fx-border-width: 1.5;">

                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="⭐" style="-fx-font-size: 18px;"/>
                                <VBox spacing="2">
                                    <Label text="Cette réponse vous a-t-elle aidé ?"
                                           style="-fx-font-weight: bold; -fx-font-size: 13px;
                                                  -fx-text-fill: #0a3d5c;"/>
                                    <Label text="Votre avis aide à améliorer la qualité des réponses"
                                           style="-fx-font-size: 10px; -fx-text-fill: #888;"/>
                                </VBox>
                            </HBox>

                            <!-- Emoji row -->
                            <HBox fx:id="emojiRow" spacing="12" alignment="CENTER_LEFT"/>

                            <Label fx:id="ratingLabel"
                                   style="-fx-text-fill: #1a6e8f; -fx-font-size: 12px;
                                          -fx-font-weight: bold; -fx-font-style: italic;"/>

                            <TextArea fx:id="commentaireField"
                                      promptText="Laissez un commentaire (optionnel)..."
                                      style="-fx-pref-height: 75; -fx-background-radius: 10;
                                             -fx-border-color: #d0e8f5; -fx-border-radius: 10;
                                             -fx-font-size: 12px; -fx-border-width: 1.5;"/>

                            <Button text="📤  Envoyer mon avis" onAction="#envoyerFeedback"
                                    style="-fx-background-color: #0a3d5c; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-pref-height: 40;
                                           -fx-background-radius: 10; -fx-font-size: 12px;
                                           -fx-padding: 0 20 0 20;"/>

                            <Label fx:id="feedbackSuccess"
                                   style="-fx-text-fill: #1a7a60; -fx-font-weight: bold;
                                          -fx-font-size: 12px;"/>
                            <Label fx:id="feedbackError"
                                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"/>
                        </VBox>
                    </VBox>
                </VBox>

                <!-- Patient reviews card -->
                <VBox spacing="0"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, #00000018, 12, 0, 0, 4);
                             -fx-border-color: #d0e8f5; -fx-border-radius: 16;
                             -fx-border-width: 1.5;">

                    <HBox spacing="10" alignment="CENTER_LEFT"
                          style="-fx-background-color: #f0f7ff;
                                 -fx-padding: 14 20 14 20;
                                 -fx-background-radius: 16 16 0 0;
                                 -fx-border-color: #e0eef8;
                                 -fx-border-width: 0 0 1 0;">
                        <Label text="💬" style="-fx-font-size: 16px;"/>
                        <Label text="Avis des patients"
                               style="-fx-font-size: 14px; -fx-font-weight: bold;
                                      -fx-text-fill: #0a3d5c;"/>
                    </HBox>

                    <VBox fx:id="feedbackListContainer" spacing="12"
                          style="-fx-padding: 18;"/>
                </VBox>

            </VBox>

            <!-- ─────────────────────────────────────────────── -->
            <!-- RIGHT COLUMN                                    -->
            <!-- ─────────────────────────────────────────────── -->
            <VBox spacing="16" prefWidth="220" minWidth="200">

                <!-- Related articles -->
                <VBox spacing="10"
                      style="-fx-background-color: white; -fx-padding: 18;
                             -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, #00000018, 12, 0, 0, 4);
                             -fx-border-color: #d0e8f5; -fx-border-radius: 16;
                             -fx-border-width: 1.5;">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="📰" style="-fx-font-size: 16px;"/>
                        <Label text="Articles relatifs"
                               style="-fx-font-size: 13px; -fx-font-weight: bold;
                                      -fx-text-fill: #0a3d5c;"/>
                    </HBox>
                    <VBox spacing="8" style="-fx-padding: 4 0 0 0;">
                        <Label text="  Comprendre les symptômes"
                               style="-fx-font-size: 11px; -fx-text-fill: #555;
                                      -fx-wrap-text: true;"/>
                        <Label text="  Quand consulter un médecin ?"
                               style="-fx-font-size: 11px; -fx-text-fill: #555;
                                      -fx-wrap-text: true;"/>
                        <Label text="  Prévention et hygiène de vie"
                               style="-fx-font-size: 11px; -fx-text-fill: #555;
                                      -fx-wrap-text: true;"/>
                        <Label text="  Médicaments courants"
                               style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
                        <Label text="  Urgences médicales"
                               style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
                    </VBox>
                </VBox>

                <!-- Disclaimer card -->
                <VBox spacing="10"
                      style="-fx-background-color: #fff8e8; -fx-padding: 18;
                             -fx-background-radius: 16;
                             -fx-border-color: #f0a500; -fx-border-radius: 16;
                             -fx-border-width: 1.5;
                             -fx-effect: dropshadow(gaussian, #00000018, 12, 0, 0, 4);">
                    <Label text="⚠️ Avertissement"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #b07000;"/>
                    <Label text="Les réponses sur cette plateforme sont données à titre informatif uniquement et ne remplacent pas une consultation médicale professionnelle."
                           style="-fx-wrap-text: true; -fx-font-size: 11px;
                                  -fx-text-fill: #7a5500; -fx-line-spacing: 3;"/>
                </VBox>

                <!-- Quick tips card -->
                <VBox spacing="10"
                      style="-fx-background-color: #0a3d5c; -fx-padding: 18;
                             -fx-background-radius: 16;
                             -fx-effect: dropshadow(gaussian, #00000018, 12, 0, 0, 4);">
                    <Label text="💡 Conseils"
                           style="-fx-font-size: 13px; -fx-font-weight: bold;
                                  -fx-text-fill: #4dd9ac;"/>
                    <Label text="📋  Notez les conseils du médecin"
                           style="-fx-font-size: 11px; -fx-text-fill: #7ecfef;
                                  -fx-wrap-text: true;"/>
                    <Label text="🔄  Suivez l'évolution de vos symptômes"
                           style="-fx-font-size: 11px; -fx-text-fill: #7ecfef;
                                  -fx-wrap-text: true;"/>
                    <Label text="📞  Consultez si les symptômes persistent"
                           style="-fx-font-size: 11px; -fx-text-fill: #7ecfef;
                                  -fx-wrap-text: true;"/>
                </VBox>

            </VBox>

        </HBox>
    </VBox>
</ScrollPane>