<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.aziz.CalendrierController"
            stylesheets="@css/style.css">

    <center>
        <VBox spacing="12">
            <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox>
                    <Label text="CALENDRIER" styleClass="page-title"/>
                    <Label text="Planning des consultations" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                </VBox>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label text="Home / Calendrier" styleClass="breadcrumb"/>
            </HBox>

            <!-- Navigation -->
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="action-bar">
                <Button text="Précédent" onAction="#handlePrevMois" styleClass="btn-edit"/>
                <Label fx:id="lblMoisAnnee" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f2b46; -fx-min-width: 200; -fx-alignment: CENTER;"/>
                <Button text="Suivant" onAction="#handleNextMois" styleClass="btn-edit"/>
                <Button text="Aujourd'hui" onAction="#handleAujourdhui" styleClass="btn-add"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label text="Statut :" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                <ComboBox fx:id="cbFiltreStatut" prefWidth="140"/>
            </HBox>

            <!-- Légende -->
            <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-padding: 4 0;">
                <HBox spacing="4" alignment="CENTER"><Label style="-fx-text-fill: #2563eb; -fx-font-size: 16;">●</Label><Label text="En cours" style="-fx-text-fill: #475569;"/></HBox>
                <HBox spacing="4" alignment="CENTER"><Label style="-fx-text-fill: #059669; -fx-font-size: 16;">●</Label><Label text="Terminée" style="-fx-text-fill: #475569;"/></HBox>
                <HBox spacing="4" alignment="CENTER"><Label style="-fx-text-fill: #dc2626; -fx-font-size: 16;">●</Label><Label text="Annulée" style="-fx-text-fill: #475569;"/></HBox>
                <HBox spacing="4" alignment="CENTER"><Label style="-fx-text-fill: #d97706; -fx-font-size: 16;">●</Label><Label text="Programmée" style="-fx-text-fill: #475569;"/></HBox>
            </HBox>

            <!-- Grille -->
            <GridPane fx:id="gridCalendrier" hgap="5" vgap="5" VBox.vgrow="ALWAYS">
                <columnConstraints>
                    <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="14.28" hgrow="ALWAYS"/>
                </columnConstraints>
            </GridPane>
        </VBox>
    </center>

    <right>
        <VBox spacing="8" prefWidth="270" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 0 1;">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <Label fx:id="lblJourSelectionne" text="Cliquez sur un jour" wrapText="true"
                   style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #0f2b46;"/>
            <ListView fx:id="listConsultationsJour" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
        </VBox>
    </right>
</BorderPane>