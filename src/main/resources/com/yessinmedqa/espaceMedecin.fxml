<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox style="-fx-background-color: #f4f7fb;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.yessinmedqa.controllers.EspaceMedecinController">

    <!-- TOP NAV BAR -->
    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #0a3d5c;                  -fx-padding: 14 28 14 28;                  -fx-effect: dropshadow(gaussian, #00000033, 8, 0, 0, 3);">
        <Label style="-fx-font-size: 26px; -fx-text-fill: #4dd9ac;" text="⚕" />
        <VBox spacing="0">
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" text="MedQA" />
            <Label style="-fx-font-size: 9px; -fx-text-fill: #7ecfef;" text="Espace Médecin" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="welcomeLabel" style="-fx-text-fill: #7ecfef; -fx-font-size: 12px;" />
        <Button onAction="#voirQuestionsRepondues" style="-fx-background-color: #1a6e8f; -fx-text-fill: white;                        -fx-font-size: 11px; -fx-font-weight: bold;                        -fx-background-radius: 20; -fx-pref-height: 32;                        -fx-padding: 0 14 0 14;" text="👁  Questions répondues" />
        <Button onAction="#seDeconnecter" style="-fx-background-color: #c0392b; -fx-text-fill: white;                        -fx-font-size: 11px; -fx-font-weight: bold;                        -fx-background-radius: 20; -fx-pref-height: 32;                        -fx-padding: 0 14 0 14;" text="⏻  Déconnexion" />
    </HBox>

    <!-- HERO BANNER -->
    <VBox spacing="6" style="-fx-background-color: #0a3d5c; -fx-padding: 20 28 20 28;">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label style="-fx-font-size: 28px;" text="⚕️" />
            <VBox spacing="4">
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" text="Espace Médecin" />
                <Label style="-fx-text-fill: #7ecfef; -fx-font-size: 12px;" text="Consultez et répondez aux questions des patients" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox alignment="CENTER" spacing="4" style="-fx-background-color: #ffffff22; -fx-padding: 10 18 10 18;                          -fx-background-radius: 12;">
                <Label fx:id="statsLabel" style="-fx-text-fill: #4dd9ac; -fx-font-size: 13px;                               -fx-font-weight: bold; -fx-text-alignment: center;" />
            </VBox>
        </HBox>
    </VBox>

    <!-- MAIN 3-COLUMN LAYOUT -->
    <HBox spacing="18" style="-fx-padding: 20 28 28 28;" VBox.vgrow="ALWAYS">

        <!-- LEFT COLUMN -->
        <VBox minWidth="200" prefWidth="220" spacing="16">

            <!-- Doctor info card -->
            <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 20;                          -fx-background-radius: 16;                          -fx-effect: dropshadow(gaussian, #00000018, 12, 0, 0, 4);                          -fx-border-color: #d0e8f5; -fx-border-radius: 16;                          -fx-border-width: 1.5;">
                <Label style="-fx-font-size: 36px;" text="👨‍⚕️" />
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0a3d5c;" text="Tableau de bord" />
                <Separator />
                <VBox spacing="8">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label style="-fx-font-size: 14px;" text="📋" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #555;" text="Questions en attente" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label style="-fx-font-size: 14px;" text="✅" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #555;" text="Répondre rapidement" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label style="-fx-font-size: 14px;" text="🤖" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #555;" text="Suggestions IA disponibles" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- RECOMMENDATIONS NOTIFICATION BOX -->
            <VBox fx:id="recommandationsBox" managed="false" spacing="10" style="-fx-background-color: #fff8e8; -fx-padding: 16;                          -fx-background-radius: 16;                          -fx-border-color: #f0a500; -fx-border-radius: 16;                          -fx-border-width: 2;                          -fx-effect: dropshadow(gaussian, #f0a50088, 14, 0, 0, 0);" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label style="-fx-font-size: 20px;" text="🔔" />
                    <VBox spacing="2">
                        <Label style="-fx-font-size: 13px; -fx-font-weight: bold;                                       -fx-text-fill: #b07000;" text="Recommandations reçues" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #c08000;" text="Un médecin vous a recommandé" />
                    </VBox>
                </HBox>
                <Separator />
                <VBox fx:id="recommandationsList" spacing="8" />
            </VBox>

            <!-- TIPS CARD -->
            <VBox spacing="12" style="-fx-background-color: linear-gradient(to bottom, #0a3d5c, #0f4c75);                          -fx-padding: 20; -fx-background-radius: 18;                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 15, 0, 0, 5);">
                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #4dd9ac;" text="💡 Conseils pratiques" />
                <Separator style="-fx-opacity: 0.2;" />
                <VBox spacing="8">
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #d6f0ff; -fx-wrap-text: true;" text="🔍 Lisez attentivement la description complète avant de répondre" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #d6f0ff; -fx-wrap-text: true;" text="🤖 L'IA propose des pistes — la décision finale vous appartient" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #d6f0ff; -fx-wrap-text: true;" text="❤️ Répondez avec clarté, précision et empathie" />
                    <Label style="-fx-font-size: 12px; -fx-text-fill: #d6f0ff; -fx-wrap-text: true;" text="📋 Vérifiez les informations essentielles : taille, poids, allergies" />
                </VBox>
            </VBox>

        </VBox>

        <!-- MIDDLE COLUMN -->
        <VBox spacing="14" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: white; -fx-padding: 14 18 14 18;                          -fx-background-radius: 12;                          -fx-effect: dropshadow(gaussian, #00000018, 8, 0, 0, 2);                          -fx-border-color: #d0e8f5; -fx-border-radius: 12;                          -fx-border-width: 1.5;">
                <Label style="-fx-font-size: 18px;" text="📋" />
                <VBox spacing="2">
                    <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0a3d5c;" text="Questions en attente de réponse" />
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #888;" text="Cliquez sur « Répondre » pour sélectionner une question" />
                </VBox>
            </HBox>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <VBox fx:id="questionsContainer" spacing="14" style="-fx-padding: 2 6 2 2;" />
            </ScrollPane>
        </VBox>

        <!-- RIGHT COLUMN — reply form -->
        <VBox minWidth="380" prefWidth="420" spacing="0" style="-fx-background-color: white; -fx-background-radius: 16;                      -fx-effect: dropshadow(gaussian, #00000018, 12, 0, 0, 4);                      -fx-border-color: #4dd9ac; -fx-border-radius: 16;                      -fx-border-width: 2;">

            <!-- Form header -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #f0faf6; -fx-padding: 16 20 16 20;                          -fx-background-radius: 16 16 0 0;                          -fx-border-color: #c8eee0; -fx-border-width: 0 0 1 0;">
                <Label style="-fx-font-size: 18px;" text="✍️" />
                <VBox spacing="2">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0a3d5c;" text="Rédiger une réponse" />
                    <Label style="-fx-font-size: 10px; -fx-text-fill: #888;" text="Sélectionnez d'abord une question" />
                </VBox>
            </HBox>

            <!-- Scrollable form content -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <VBox spacing="14" style="-fx-padding: 20;">

                    <!-- Selected question box -->
                    <VBox fx:id="selectedQuestionBox" managed="false" spacing="4" style="-fx-background-color: #eaf6ff; -fx-padding: 10;                                  -fx-background-radius: 8;                                  -fx-border-color: #1a6e8f; -fx-border-radius: 8;                                  -fx-border-width: 1;" visible="false">
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #1a6e8f;                                       -fx-font-weight: bold;" text="📝 Question sélectionnée :" />
                        <Label fx:id="selectedQuestionLabel" style="-fx-text-fill: #0a3d5c; -fx-font-size: 11px;                                       -fx-wrap-text: true; -fx-font-weight: bold;" />
                    </VBox>

                    <!-- AI suggestions box -->
                    <VBox fx:id="aiBox" managed="false" spacing="10" style="-fx-background-color: #f0faf6; -fx-padding: 14;              -fx-background-radius: 10;              -fx-border-color: #4dd9ac; -fx-border-radius: 10;              -fx-border-width: 1.5;" visible="false">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label style="-fx-font-size: 16px;" text="🤖" />
                            <VBox spacing="2">
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #0a3d5c;                           -fx-font-size: 14px;" text="Suggestions IA" />
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #555;" text="Indicatif — vous restez décisionnaire" />
                            </VBox>
                        </HBox>
                        <Label fx:id="aiLoading" style="-fx-text-fill: #888; -fx-font-size: 10px;                   -fx-font-style: italic;" />
                        <!-- hidden label still needed by controller -->
                        <Label fx:id="aiLabel" managed="false" visible="false" />
                    </VBox>

                    <!-- Answer textarea -->
                    <VBox spacing="6">
                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold;                                       -fx-text-fill: #0a3d5c;" text="✏️ Votre réponse" />
                        <TextArea fx:id="reponseField" promptText="Rédigez votre réponse médicale ici..." style="-fx-pref-height: 160; -fx-background-radius: 10;                                          -fx-border-color: #d0e8f5; -fx-border-radius: 10;                                          -fx-font-size: 13px; -fx-border-width: 1.5;" />
                        <Label fx:id="reponseError" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;" />
                    </VBox>

                    <!-- Submit button -->
                    <Button onAction="#soumettreReponse" prefWidth="436.0" style="-fx-background-color: #0a3d5c; -fx-text-fill: white;                                    -fx-font-weight: bold; -fx-pref-height: 44;                                    -fx-pref-width: 260; -fx-background-radius: 12;                                    -fx-font-size: 13px;                                    -fx-effect: dropshadow(gaussian, #0a3d5c66, 8, 0, 0, 3);" text="📤  Soumettre la réponse" />

                    <!-- Success message -->
                    <HBox fx:id="successBox" alignment="CENTER_LEFT" managed="false" spacing="8" style="-fx-background-color: #e8f8f0; -fx-padding: 12 16 12 16;                                  -fx-background-radius: 10; -fx-border-color: #4dd9ac;                                  -fx-border-radius: 10; -fx-border-width: 1;" visible="false">
                        <Label style="-fx-font-size: 16px;" text="✅" />
                        <Label fx:id="successLabel" style="-fx-text-fill: #0a7a50; -fx-font-weight: bold;                                       -fx-font-size: 12px;" />
                    </HBox>

                </VBox>
            </ScrollPane>

        </VBox>

    </HBox>
</VBox>
