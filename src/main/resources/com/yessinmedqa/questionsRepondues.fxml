<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.yessinmedqa.controllers.QuestionsRepController"
      style="-fx-background-color: #f4f7fb;">

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- TOP NAV BAR — same as poserQuestion                 -->
    <!-- ═══════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: #0a3d5c;
                 -fx-padding: 14 28 14 28;
                 -fx-effect: dropshadow(gaussian, #00000033, 8, 0, 0, 3);">

        <Label text="⚕"
               style="-fx-font-size: 26px; -fx-text-fill: #4dd9ac;"/>
        <VBox spacing="0">
            <Label text="MedQA"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Plateforme Médicale"
                   style="-fx-font-size: 9px; -fx-text-fill: #7ecfef;"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Search bar -->
        <TextField fx:id="searchField"
                   promptText="🔍  Rechercher une question..."
                   style="-fx-pref-width: 280; -fx-pref-height: 34;
                          -fx-background-radius: 20; -fx-padding: 0 14 0 14;
                          -fx-font-size: 12px; -fx-border-color: transparent;"/>

        <Button text="Rechercher" onAction="#rechercher"
                style="-fx-background-color: #4dd9ac; -fx-text-fill: #0a3d5c;
                       -fx-font-weight: bold; -fx-pref-height: 34;
                       -fx-background-radius: 20; -fx-font-size: 12px;
                       -fx-padding: 0 16 0 16;"/>

        <Button fx:id="poserBtn" onAction="#allerPoserQuestion"
                style="-fx-background-color: #1a6e8f; -fx-text-fill: white;
               -fx-font-size: 11px; -fx-font-weight: bold;
               -fx-background-radius: 20; -fx-pref-height: 32;
               -fx-padding: 0 14 0 14;"/>

        <Button text="⏻  Déconnexion" onAction="#seDeconnecter"
                style="-fx-background-color: #c0392b; -fx-text-fill: white;
                       -fx-font-size: 11px; -fx-font-weight: bold;
                       -fx-background-radius: 20; -fx-pref-height: 32;
                       -fx-padding: 0 14 0 14;"/>
    </HBox>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- HERO BANNER                                         -->
    <!-- ═══════════════════════════════════════════════════ -->
    <VBox spacing="6"
          style="-fx-background-color: #0a3d5c;
                 -fx-padding: 20 28 20 28;">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="💬" style="-fx-font-size: 28px;"/>
            <VBox spacing="3">
                <Label text="Questions Médicales Répondues"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;
                              -fx-text-fill: white;"/>
                <Label text="Consultez les réponses de nos médecins spécialisés"
                       style="-fx-text-fill: #7ecfef; -fx-font-size: 12px;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- 3 COLUMN LAYOUT                                     -->
    <!-- ═══════════════════════════════════════════════════ -->
    <HBox spacing="18" style="-fx-padding: 20 28 20 28;" VBox.vgrow="ALWAYS">

        <!-- ─────────────────────────────────────────────── -->
        <!-- LEFT COLUMN                                     -->
        <!-- ─────────────────────────────────────────────── -->
        <VBox spacing="16" prefWidth="230" minWidth="210">

            <!-- Patient card — hidden for doctors -->
            <VBox fx:id="patientCard" spacing="12"
                  style="-fx-background-color: white;
                         -fx-padding: 20; -fx-background-radius: 16;
                         -fx-effect: dropshadow(gaussian, #00000018, 12, 0, 0, 4);
                         -fx-border-color: #d0e8f5; -fx-border-radius: 16;
                         -fx-border-width: 1.5;">
                <Label text="🩺" style="-fx-font-size: 28px;"/>
                <Label text="Posez votre question"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;
                              -fx-text-fill: #0a3d5c; -fx-wrap-text: true;"/>
                <Label text="Un médecin spécialisé répondra dans les plus brefs délais"
                       style="-fx-wrap-text: true; -fx-text-fill: #666;
                              -fx-font-size: 11px;"/>
                <Button text="✏️  Poser ma question" onAction="#allerPoserQuestion"
                        style="-fx-background-color: #0a3d5c; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-pref-width: 185;
                               -fx-pref-height: 38; -fx-background-radius: 10;
                               -fx-font-size: 12px;"/>
            </VBox>

            <!-- Actes relatifs -->
            <VBox spacing="10"
                  style="-fx-background-color: white; -fx-padding: 18;
                         -fx-background-radius: 16;
                         -fx-effect: dropshadow(gaussian, #00000018, 12, 0, 0, 4);
                         -fx-border-color: #d0e8f5; -fx-border-radius: 16;
                         -fx-border-width: 1.5;">

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="📋" style="-fx-font-size: 16px;"/>
                    <Label text="Actes relatifs"
                           style="-fx-font-size: 13px; -fx-font-weight: bold;
                                  -fx-text-fill: #0a3d5c;"/>
                </HBox>

                <VBox spacing="7" style="-fx-padding: 4 0 0 0;">
                    <Label text="  Arthroplastie avec implantation..."
                           style="-fx-font-size: 11px; -fx-text-fill: #555;
                                  -fx-wrap-text: true; -fx-cursor: hand;"/>
                    <Label text="  Traitement chirurgical de l'hernie..."
                           style="-fx-font-size: 11px; -fx-text-fill: #555;
                                  -fx-wrap-text: true; -fx-cursor: hand;"/>
                    <Label text="  Chirurgie du rachis"
                           style="-fx-font-size: 11px; -fx-text-fill: #555;
                                  -fx-cursor: hand;"/>
                    <Label text="  Prothèse Totale du genou"
                           style="-fx-font-size: 11px; -fx-text-fill: #555;
                                  -fx-cursor: hand;"/>
                    <Label text="  Prothèse totale de hanche..."
                           style="-fx-font-size: 11px; -fx-text-fill: #555;
                                  -fx-wrap-text: true; -fx-cursor: hand;"/>
                    <Label text="  Traitement des cicatrices..."
                           style="-fx-font-size: 11px; -fx-text-fill: #555;
                                  -fx-wrap-text: true; -fx-cursor: hand;"/>
                </VBox>
            </VBox>

        </VBox>

        <!-- ─────────────────────────────────────────────── -->
        <!-- MIDDLE COLUMN — question cards                  -->
        <!-- ─────────────────────────────────────────────── -->
        <VBox spacing="0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent;
                               -fx-background: transparent;">
                <VBox fx:id="cardsContainer" spacing="14"
                      style="-fx-padding: 2 6 2 2;"/>
            </ScrollPane>
        </VBox>

        <!-- ─────────────────────────────────────────────── -->
        <!-- RIGHT COLUMN — categories                       -->
        <!-- ─────────────────────────────────────────────── -->
        <VBox spacing="16" prefWidth="230" minWidth="210">

            <VBox spacing="10"
                  style="-fx-background-color: white; -fx-padding: 18;
                         -fx-background-radius: 16;
                         -fx-effect: dropshadow(gaussian, #00000018, 12, 0, 0, 4);
                         -fx-border-color: #d0e8f5; -fx-border-radius: 16;
                         -fx-border-width: 1.5;">

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="🗂️" style="-fx-font-size: 16px;"/>
                    <Label text="Catégories"
                           style="-fx-font-size: 13px; -fx-font-weight: bold;
                                  -fx-text-fill: #0a3d5c;"/>
                </HBox>

                <VBox spacing="2" style="-fx-padding: 4 0 0 0;">
                    <Button text="  Toutes les catégories" onAction="#filtrerCategorie"
                            style="-fx-background-color: #0a3d5c; -fx-text-fill: white;
                                   -fx-font-size: 11px; -fx-font-weight: bold;
                                   -fx-alignment: CENTER_LEFT; -fx-pref-width: 194;
                                   -fx-pref-height: 30; -fx-background-radius: 8;
                                   -fx-cursor: hand;"/>
                    <Button text="  Gynécologie" onAction="#filtrerCategorie"
                            style="-fx-background-color: transparent; -fx-text-fill: #444;
                                   -fx-font-size: 11px; -fx-alignment: CENTER_LEFT;
                                   -fx-pref-width: 194; -fx-pref-height: 28;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                    <Button text="  Dermatologie" onAction="#filtrerCategorie"
                            style="-fx-background-color: transparent; -fx-text-fill: #444;
                                   -fx-font-size: 11px; -fx-alignment: CENTER_LEFT;
                                   -fx-pref-width: 194; -fx-pref-height: 28;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                    <Button text="  Psychiatrie" onAction="#filtrerCategorie"
                            style="-fx-background-color: transparent; -fx-text-fill: #444;
                                   -fx-font-size: 11px; -fx-alignment: CENTER_LEFT;
                                   -fx-pref-width: 194; -fx-pref-height: 28;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                    <Button text="  O.R.L" onAction="#filtrerCategorie"
                            style="-fx-background-color: transparent; -fx-text-fill: #444;
                                   -fx-font-size: 11px; -fx-alignment: CENTER_LEFT;
                                   -fx-pref-width: 194; -fx-pref-height: 28;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                    <Button text="  Sexologie" onAction="#filtrerCategorie"
                            style="-fx-background-color: transparent; -fx-text-fill: #444;
                                   -fx-font-size: 11px; -fx-alignment: CENTER_LEFT;
                                   -fx-pref-width: 194; -fx-pref-height: 28;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                    <Button text="  Urologie" onAction="#filtrerCategorie"
                            style="-fx-background-color: transparent; -fx-text-fill: #444;
                                   -fx-font-size: 11px; -fx-alignment: CENTER_LEFT;
                                   -fx-pref-width: 194; -fx-pref-height: 28;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                    <Button text="  Cardiologie" onAction="#filtrerCategorie"
                            style="-fx-background-color: transparent; -fx-text-fill: #444;
                                   -fx-font-size: 11px; -fx-alignment: CENTER_LEFT;
                                   -fx-pref-width: 194; -fx-pref-height: 28;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                    <Button text="  Médecine générale" onAction="#filtrerCategorie"
                            style="-fx-background-color: transparent; -fx-text-fill: #444;
                                   -fx-font-size: 11px; -fx-alignment: CENTER_LEFT;
                                   -fx-pref-width: 194; -fx-pref-height: 28;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                    <Button text="  Médecine dentaire" onAction="#filtrerCategorie"
                            style="-fx-background-color: transparent; -fx-text-fill: #444;
                                   -fx-font-size: 11px; -fx-alignment: CENTER_LEFT;
                                   -fx-pref-width: 194; -fx-pref-height: 28;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                    <Button text="  Ophtalmologie" onAction="#filtrerCategorie"
                            style="-fx-background-color: transparent; -fx-text-fill: #444;
                                   -fx-font-size: 11px; -fx-alignment: CENTER_LEFT;
                                   -fx-pref-width: 194; -fx-pref-height: 28;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                    <Button text="  Pédiatrie" onAction="#filtrerCategorie"
                            style="-fx-background-color: transparent; -fx-text-fill: #444;
                                   -fx-font-size: 11px; -fx-alignment: CENTER_LEFT;
                                   -fx-pref-width: 194; -fx-pref-height: 28;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                    <Button text="  Endocrinologie" onAction="#filtrerCategorie"
                            style="-fx-background-color: transparent; -fx-text-fill: #444;
                                   -fx-font-size: 11px; -fx-alignment: CENTER_LEFT;
                                   -fx-pref-width: 194; -fx-pref-height: 28;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                    <Button text="  Orthopédie" onAction="#filtrerCategorie"
                            style="-fx-background-color: transparent; -fx-text-fill: #444;
                                   -fx-font-size: 11px; -fx-alignment: CENTER_LEFT;
                                   -fx-pref-width: 194; -fx-pref-height: 28;
                                   -fx-cursor: hand; -fx-border-color: transparent;"/>
                </VBox>
            </VBox>

            <!-- Quick stats card -->
            <VBox spacing="10"
                  style="-fx-background-color: #0a3d5c; -fx-padding: 18;
                         -fx-background-radius: 16;
                         -fx-effect: dropshadow(gaussian, #00000018, 12, 0, 0, 4);">
                <Label text="📊 Statistiques"
                       style="-fx-font-size: 13px; -fx-font-weight: bold;
                              -fx-text-fill: #4dd9ac;"/>
                <VBox spacing="8">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="💬"  style="-fx-font-size: 14px;"/>
                        <Label fx:id="statRepondues"
                               text="— questions répondues"
                               style="-fx-text-fill: white; -fx-font-size: 11px;"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="👨‍⚕️" style="-fx-font-size: 14px;"/>
                        <Label text="Médecins certifiés"
                               style="-fx-text-fill: #7ecfef; -fx-font-size: 11px;"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="⭐" style="-fx-font-size: 14px;"/>
                        <Label text="Avis patients disponibles"
                               style="-fx-text-fill: #7ecfef; -fx-font-size: 11px;"/>
                    </HBox>
                </VBox>
            </VBox>

        </VBox>

    </HBox>

</VBox>