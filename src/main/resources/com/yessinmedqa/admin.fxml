<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.yessinmedqa.controllers.AdminController"
      style="-fx-background-color: #f0f4f8;">

    <!-- TOP NAV -->
    <HBox style="-fx-background-color: #1a1a2e; -fx-padding: 14 25 14 25;"
          spacing="15" alignment="CENTER_LEFT">
        <Label text="🛡️ Espace Admin"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🚪 Déconnexion" onAction="#seDeconnecter"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-background-radius: 8;"/>
    </HBox>

    <HBox spacing="0" VBox.vgrow="ALWAYS">

        <!-- LEFT SIDEBAR -->
        <VBox spacing="5" prefWidth="200"
              style="-fx-background-color: #16213e; -fx-padding: 20 10 20 10;">

            <Label text="MENU" style="-fx-text-fill: #888; -fx-font-size: 10px;
                                      -fx-font-weight: bold; -fx-padding: 0 0 10 5;"/>

            <Button text="📊 Dashboard"     onAction="#showDashboard"
                    fx:id="btnDashboard"
                    style="-fx-background-color: #0f3460; -fx-text-fill: white;
                           -fx-pref-width: 180; -fx-pref-height: 38;
                           -fx-background-radius: 8; -fx-font-size: 12px;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 12;"/>

            <Button text="👥 Utilisateurs"  onAction="#showUsers"
                    fx:id="btnUsers"
                    style="-fx-background-color: transparent; -fx-text-fill: #aaa;
                           -fx-pref-width: 180; -fx-pref-height: 38;
                           -fx-background-radius: 8; -fx-font-size: 12px;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 12;"/>

            <Button text="❓ Questions"     onAction="#showQuestions"
                    fx:id="btnQuestions"
                    style="-fx-background-color: transparent; -fx-text-fill: #aaa;
                           -fx-pref-width: 180; -fx-pref-height: 38;
                           -fx-background-radius: 8; -fx-font-size: 12px;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 12;"/>

            <Button text="💬 Réponses"      onAction="#showReponses"
                    fx:id="btnReponses"
                    style="-fx-background-color: transparent; -fx-text-fill: #aaa;
                           -fx-pref-width: 180; -fx-pref-height: 38;
                           -fx-background-radius: 8; -fx-font-size: 12px;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 12;"/>

            <Button text="🚩 Signalements"  onAction="#showReports"
                    fx:id="btnReports"
                    style="-fx-background-color: transparent; -fx-text-fill: #aaa;
                           -fx-pref-width: 180; -fx-pref-height: 38;
                           -fx-background-radius: 8; -fx-font-size: 12px;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 12;"/>
        </VBox>

        <!-- MAIN CONTENT -->
        <VBox HBox.hgrow="ALWAYS" style="-fx-padding: 25;">

            <!-- STATS ROW -->
            <HBox fx:id="statsRow" spacing="15" style="-fx-padding: 0 0 20 0;">
                <VBox fx:id="statUsers"   prefWidth="150" prefHeight="80" alignment="CENTER"
                      style="-fx-background-color: #0f3460; -fx-background-radius: 12;">
                    <Label fx:id="statUsersCount"  text="0"
                           style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                    <Label text="Utilisateurs"
                           style="-fx-text-fill: #aaa; -fx-font-size: 11px;"/>
                </VBox>
                <VBox fx:id="statQuest"   prefWidth="150" prefHeight="80" alignment="CENTER"
                      style="-fx-background-color: #1aaa8a; -fx-background-radius: 12;">
                    <Label fx:id="statQuestCount"  text="0"
                           style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                    <Label text="Questions"
                           style="-fx-text-fill: #e8f8e8; -fx-font-size: 11px;"/>
                </VBox>
                <VBox fx:id="statRep"     prefWidth="150" prefHeight="80" alignment="CENTER"
                      style="-fx-background-color: #0a5f7a; -fx-background-radius: 12;">
                    <Label fx:id="statRepCount"    text="0"
                           style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                    <Label text="Réponses"
                           style="-fx-text-fill: #c8eaed; -fx-font-size: 11px;"/>
                </VBox>
                <VBox fx:id="statSignal"  prefWidth="150" prefHeight="80" alignment="CENTER"
                      style="-fx-background-color: #e74c3c; -fx-background-radius: 12;">
                    <Label fx:id="statSignalCount" text="0"
                           style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                    <Label text="Signalements"
                           style="-fx-text-fill: #fdd; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>

            <!-- DYNAMIC CONTENT AREA -->
            <Label fx:id="sectionTitle" text="📊 Dashboard"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;
                          -fx-text-fill: #1a1a2e; -fx-padding: 0 0 12 0;"/>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="contentArea" spacing="12"/>
            </ScrollPane>

        </VBox>
    </HBox>
</VBox>