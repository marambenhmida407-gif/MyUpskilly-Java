{% extends 'base.html.twig' %}
{% block title %}Pathologies{% endblock %}
{% block page_title %}🦠 Pathologies{% endblock %}

{% block body %}

{# Stats #}
<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card-stat text-center">
        <div class="fw-bold" style="font-size:2rem;color:#0a5f7a;">{{ stats.total }}</div>
        <div class="text-muted small">Total Pathologies</div>
    </div></div>
    <div class="col-md-3"><div class="card-stat text-center">
        <div class="fw-bold" style="font-size:2rem;color:#1aaa8a;">{{ stats.faible }}</div>
        <div class="text-muted small">Faibles</div>
    </div></div>
    <div class="col-md-3"><div class="card-stat text-center">
        <div class="fw-bold" style="font-size:2rem;color:#f39c12;">{{ stats.moderee }}</div>
        <div class="text-muted small">Modérées</div>
    </div></div>
    <div class="col-md-3"><div class="card-stat text-center">
        <div class="fw-bold" style="font-size:2rem;color:#e74c3c;">{{ stats.critique }}</div>
        <div class="text-muted small">Critiques</div>
    </div></div>
</div>

{# Charts #}
<div class="row g-3 mb-3">
    <div class="col-md-5">
        <div class="card-stat">
            <div class="fw-bold small mb-2" style="color:#0a5f7a;">Répartition par gravité</div>
            <canvas id="pieChart" height="200"></canvas>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card-stat">
            <div class="fw-bold small mb-2" style="color:#0a5f7a;">Distribution par type</div>
            <canvas id="barChart" height="200"></canvas>
        </div>
    </div>
</div>

{# Filtres #}
<div class="card-stat mb-3">
    <form method="get" class="d-flex gap-2 flex-wrap align-items-center">
        <input type="text" name="search" value="{{ keyword }}" class="form-control"
               placeholder="Nom..." style="max-width:200px;">
        <select name="type" class="form-select" style="max-width:160px;">
            <option value="">Tous types</option>
            {% for t in ['chronique','infectieuse','hereditaire','degenerative','aigue'] %}
                <option value="{{ t }}" {{ type == t ? 'selected' }}>{{ t }}</option>
            {% endfor %}
        </select>
        <select name="gravite" class="form-select" style="max-width:140px;">
            <option value="">Toutes gravités</option>
            {% for g in ['faible','moderee','critique'] %}
                <option value="{{ g }}" {{ gravite == g ? 'selected' }}>{{ g }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="btn btn-primary">🔍</button>
        <a href="{{ path('app_patologie_export') }}" class="btn btn-success">📊 Export Excel</a>
        <a href="{{ path('app_patologie_new') }}" class="btn btn-primary ms-auto">＋ Ajouter</a>
    </form>
</div>

{# Table #}
<div class="card-stat">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr><th>#</th><th>Nom</th><th>Type</th><th>Gravité</th><th>Patient</th><th>Actions</th></tr>
        </thead>
        <tbody>
        {% for p in patologies %}
        <tr>
            <td>{{ attribute(p, 'id') }}</td>
            <td class="fw-bold">{{ p.nom }}</td>
            <td>{{ p.type ?? '—' }}</td>
            <td><span class="badge {{ p.gravite == 'faible' ? 'badge-green' : (p.gravite == 'moderee' ? 'badge-orange' : 'bg-danger') }}">
                {{ p.gravite ?? '—' }}
            </span></td>
            <td>{{ p.userNom ?? '—' }}</td>
            <td>
                {# Médicaments FDA #}
                <button class="btn btn-sm btn-outline-info"
                        onclick="searchFDA('{{ p.nom|e('js') }}')"
                        title="Médicaments FDA">💊</button>

                <a href="{{ path('app_patologie_edit', {id: attribute(p, 'id')}) }}"
                   class="btn btn-sm btn-outline-primary">✏️</a>

                <form method="post"
                      action="{{ path('app_patologie_delete', {id: attribute(p, 'id')}) }}"
                      class="d-inline"
                      onsubmit="return confirm('Supprimer cette pathologie ?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger">🗑</button>
                </form>
            </td>
        </tr>
        {% else %}
        <tr><td colspan="6" class="text-center text-muted py-3">Aucune pathologie.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{# Modal FDA #}
<div class="modal fade" id="fdaModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background:#0a5f7a;color:white;">
                <h5 class="modal-title">💊 Médicaments FDA — <span id="fda-title"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="fda-body">
                <div class="text-center text-muted py-4">⏳ Recherche en cours...</div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// ── Charts ────────────────────────────────────────────────────────────────

// Données pour les charts
const graviteData = {
    labels: ['Faible', 'Modérée', 'Critique'],
    datasets: [{
        data: [{{ stats.faible }}, {{ stats.moderee }}, {{ stats.critique }}],
        backgroundColor: ['#1aaa8a', '#f39c12', '#e74c3c'],
    }]
};

const typeData = (() => {
    const counts = {};
    {% for p in patologies %}
    const t = '{{ p.type ?? "Autre" }}';
    counts[t] = (counts[t] || 0) + 1;
    {% endfor %}
    return {
        labels: Object.keys(counts),
        datasets: [{
            label: 'Pathologies',
            data: Object.values(counts),
            backgroundColor: '#0a5f7a',
        }]
    };
})();

new Chart(document.getElementById('pieChart'), {
    type: 'pie',
    data: graviteData,
    options: { plugins: { legend: { position: 'bottom' } }, responsive: true }
});

new Chart(document.getElementById('barChart'), {
    type: 'bar',
    data: typeData,
    options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
    }
});

// ── FDA Search ─────────────────────────────────────────────────────────────

function searchFDA(nom) {
    document.getElementById('fda-title').textContent = nom;
    document.getElementById('fda-body').innerHTML = '<div class="text-center text-muted py-4">⏳ Recherche OpenFDA en cours...</div>';
    new bootstrap.Modal(document.getElementById('fdaModal')).show();

    fetch(`{{ path('app_patologie_fda') }}?nom=${encodeURIComponent(nom)}`)
        .then(r => r.json())
        .then(data => {
            const results = data.results ?? [];
            const term    = data.searchTerm ?? nom;

            if (results.length === 0) {
                document.getElementById('fda-body').innerHTML = `
                    <div class="text-center text-muted py-4">
                        <div style="font-size:2rem;">💊</div>
                        <div>Aucun médicament trouvé pour « ${nom} »</div>
                        <div class="small mt-1">Terme recherché : <em>${term}</em></div>
                    </div>`;
                return;
            }

            let html = `<div class="small text-muted mb-3">
                Médicaments trouvés pour : <strong>${nom}</strong>
                (recherché en anglais : <em>${term}</em>)
            </div>`;

            results.forEach(r => {
                html += `
                <div class="rounded p-3 mb-2" style="border:1px solid #d0e8f5; background:#f8fcff;">
                    <div class="fw-bold" style="color:#0a3d5c;">💊 ${r.name}</div>
                    ${r.generic ? `<div class="small text-muted">Générique : ${r.generic}</div>` : ''}
                    ${r.indication ? `<div class="small mt-1" style="color:#555;">${r.indication}</div>` : ''}
                </div>`;
            });

            document.getElementById('fda-body').innerHTML = html;
        })
        .catch(() => {
            document.getElementById('fda-body').innerHTML =
                '<div class="text-danger text-center py-3">❌ Erreur réseau — OpenFDA indisponible</div>';
        });
}
</script>
{% endblock %}