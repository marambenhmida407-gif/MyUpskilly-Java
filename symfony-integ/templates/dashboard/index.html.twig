{% extends 'base.html.twig' %}
{% block title %}Tableau de bord{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}

{% block body %}
<div class="mb-4">
    <h4 style="color:#0a5f7a;">Bonjour, Dr {{ user.prenom }} {{ user.nom }}</h4>
    <p class="text-muted">Statistiques en temps réel de tous les suivis et prescriptions.</p>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    {% set stat_items = [
        {label: 'Suivis', value: stats.total_suivis, color: '#0a5f7a'},
        {label: 'En cours', value: stats.en_cours, color: '#1aaa8a'},
        {label: 'Terminé', value: stats.termine, color: '#6c757d'},
        {label: 'Suspendu', value: stats.suspendu, color: '#f39c12'},
        {label: 'Planifié', value: stats.planifie, color: '#3498db'},
        {label: 'Prescriptions', value: stats.prescriptions, color: '#9b59b6'},
        {label: 'Avec Rec.', value: stats.avec_rec, color: '#2ecc71'},
        {label: 'Sans Rec.', value: stats.sans_rec, color: '#e74c3c'},
    ] %}
    {% for item in stat_items %}
    <div class="col-md-3 col-6">
        <div class="card-stat text-center">
            <div class="fw-bold" style="font-size:2rem; color:{{ item.color }};">{{ item.value }}</div>
            <div class="text-muted small text-uppercase">{{ item.label }}</div>
        </div>
    </div>
    {% endfor %}
</div>

<!-- Quick Actions -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <h6 class="text-muted text-uppercase mb-3" style="font-size:0.75rem; letter-spacing:1px;">Accès Rapide</h6>
    </div>
    <div class="col-md-3">
        <a href="{{ path('app_suivi_new') }}" class="card-stat text-decoration-none d-block hover-card">
            <div class="d-flex align-items-center gap-3">
                <div style="font-size:24px;">📋</div>
                <div>
                    <div class="fw-bold" style="color:#0a5f7a;">Nouveau suivi</div>
                    <div class="text-muted small">Créer un suivi thérapeutique</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="{{ path('app_prescription_new') }}" class="card-stat text-decoration-none d-block">
            <div class="d-flex align-items-center gap-3">
                <div style="font-size:24px;">💊</div>
                <div>
                    <div class="fw-bold" style="color:#0a5f7a;">Nouvelle prescription</div>
                    <div class="text-muted small">Ajouter une prescription médicale</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="{{ path('app_consultations') }}" class="card-stat text-decoration-none d-block">
            <div class="d-flex align-items-center gap-3">
                <div style="font-size:24px;">🩺</div>
                <div>
                    <div class="fw-bold" style="color:#0a5f7a;">Consultations</div>
                    <div class="text-muted small">Gérer les consultations</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="{{ path('app_patologies') }}" class="card-stat text-decoration-none d-block">
            <div class="d-flex align-items-center gap-3">
                <div style="font-size:24px;">🦠</div>
                <div>
                    <div class="fw-bold" style="color:#0a5f7a;">Pathologies</div>
                    <div class="text-muted small">Consulter les pathologies</div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Recent Suivis -->
{% if suivis|length > 0 %}
<div class="card-stat">
    <h6 class="fw-bold mb-3" style="color:#0a5f7a;">Suivis Récents</h6>
    <table class="table table-hover mb-0">
        <thead class="table-light"><tr><th>Patient</th><th>Type</th><th>Objectif</th><th>Statut</th><th>Début</th></tr></thead>
        <tbody>
        {% for s in suivis %}
        <tr>
            <td>{{ s.patientNom ?? '#' ~ s.patientId }}</td>
            <td>{{ s.typeSuivi }}</td>
            <td class="text-truncate" style="max-width:200px;">{{ s.objectifTherapeutique }}</td>
            <td>
                <span class="badge badge-{{ s.statut == 'En cours' ? 'green' : (s.statut == 'Planifié' ? 'blue' : (s.statut == 'Suspendu' ? 'orange' : 'dark')) }}">
                    {{ s.statut }}
                </span>
            </td>
            <td>{{ s.dateDebut ? s.dateDebut|date('d/m/Y') : '' }}</td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}
{% endblock %}
