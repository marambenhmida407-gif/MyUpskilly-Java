{% extends 'base.html.twig' %}
{% block title %}Gestion Utilisateurs{% endblock %}
{% block page_title %}👥 Gestion des Utilisateurs{% endblock %}

{% block body %}
<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="card-stat text-center"><div class="fw-bold" style="font-size:2rem;color:#0a5f7a;">{{ stats.total }}</div><div class="text-muted small">Total</div></div></div>
    <div class="col-md-3"><div class="card-stat text-center"><div class="fw-bold" style="font-size:2rem;color:#1aaa8a;">{{ stats.verifies }}</div><div class="text-muted small">Vérifiés</div></div></div>
    <div class="col-md-3"><div class="card-stat text-center"><div class="fw-bold" style="font-size:2rem;color:#2ecc71;">{{ stats.actifs }}</div><div class="text-muted small">Actifs</div></div></div>
    <div class="col-md-3">
        <div class="card-stat">
            {% for r, c in by_role %}
                <div class="d-flex justify-content-between"><span class="text-capitalize">{{ r }}</span><span class="badge bg-secondary">{{ c }}</span></div>
            {% endfor %}
        </div>
    </div>
</div>

<!-- Filters + Add -->
<div class="card-stat mb-3">
    <form method="get" class="d-flex gap-2 flex-wrap align-items-end">
        <div><input type="text" name="search" value="{{ search }}" class="form-control" placeholder="Nom ou email..."></div>
        <div>
            <select name="role" class="form-select">
                <option value="">Tous les rôles</option>
                <option value="patient" {{ role == 'patient' ? 'selected' }}>Patient</option>
                <option value="doctor"  {{ role == 'doctor'  ? 'selected' }}>Médecin</option>
                <option value="admin"   {{ role == 'admin'   ? 'selected' }}>Admin</option>
            </select>
        </div>
        <div>
            <select name="etat" class="form-select">
                <option value="">Tous les états</option>
                <option value="actif"   {{ etat == 'actif'   ? 'selected' }}>Actif</option>
                <option value="inactif" {{ etat == 'inactif' ? 'selected' }}>Inactif</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">🔍 Filtrer</button>
        <a href="{{ path('app_admin_users') }}" class="btn btn-outline-secondary">Réinitialiser</a>
        <a href="{{ path('app_admin_user_new') }}" class="btn btn-success ms-auto">＋ Ajouter</a>
    </form>
</div>

<!-- Table -->
<div class="card-stat">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr><th>ID</th><th>Nom</th><th>Email</th><th>Rôle</th><th>Spécialité</th><th>Vérifié</th><th>État</th><th>Actions</th></tr>
        </thead>
        <tbody>
        {% for u in users %}
        <tr>
            <td>{{ attribute(u, 'id') }}</td>
            <td>{{ u.prenom }} {{ u.nom }}</td>
            <td>{{ u.email }}</td>
            <td><span class="badge bg-{{ u.role == 'admin' ? 'danger' : (u.role == 'doctor' ? 'primary' : 'secondary') }}">{{ u.role }}</span></td>
            <td>{{ u.specialite ?? '—' }}</td>
            <td>{{ u.isVerified ? '✅' : '❌' }}</td>
            <td>
                {% if u.isActif %}
                    <span class="badge badge-green">✅ Actif</span>
                {% else %}
                    <span class="badge bg-danger">🚫 Inactif</span>
                {% endif %}
            </td>
            <td>
                <a href="{{ path('app_admin_user_edit', {id: attribute(u, 'id')}) }}" class="btn btn-sm btn-outline-primary">✏️</a>
                <form method="post" action="{{ path('app_admin_user_toggle', {id: attribute(u, 'id')}) }}" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-warning">⊘</button>
                </form>
                <form method="post" action="{{ path('app_admin_user_delete', {id: attribute(u, 'id')}) }}" class="d-inline" onsubmit="return confirm('Supprimer cet utilisateur ?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger">🗑</button>
                </form>
            </td>
        </tr>
        {% else %}
        <tr><td colspan="8" class="text-center text-muted">Aucun utilisateur trouvé.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
